# =============================================================================
# Youmi Lens — copy to .env and fill values. Vite only exposes vars prefixed VITE_.
# =============================================================================

# --- Cloud login & data (Mac 公测：建议始终配置，便于发给别人试用) ---
# With BOTH URL and anon key set, the app shows login (email magic link only in the UI).
# Enable Email + OAuth providers under Supabase Dashboard → Authentication → Providers.
# Leave VITE_SUPABASE_ANON_KEY unset to land on the setup page (local-only or add keys later).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# --- AI / transcription (生产构建：前端固定走后端代理；勿把用户 OpenAI key 打进公测包) ---
# Production / split deploy: public HTTPS origin of your AI proxy server (no trailing slash).
# The app calls `${VITE_API_BASE_URL}/api/transcribe`, `/api/summarize`, etc. (see getAiApiBase).
# Leave unset in local dev: Vite dev server proxies /api to the local Node AI server.
# **Tauri Mac trial (tauri build):** set VITE_API_BASE_URL in .env.production — required; see docs/tauri-desktop-trial-p0.md
# VITE_API_BASE_URL=https://your-ai-server.example.com

# --- QA/staging builds (.env.qa.local — gitignored, not this file) ---
# `.env.qa.local` MUST also set its own VITE_API_BASE_URL. Vite loads .env
# first and .env.qa.local on top of it, so any var .env.qa.local does not
# override is silently inherited from .env — including VITE_API_BASE_URL
# pointing at PRODUCTION. That exact gap once made every Save Lecture upload
# in a qa-staging build fail auth (a staging-signed JWT sent to the
# production API server), identically for every course, with no useful error.
# Point it at a server that shares the SAME Supabase project as the staging
# VITE_SUPABASE_URL above it — typically the local dev server:
#   VITE_API_BASE_URL=http://127.0.0.1:3847
# `vite.config.ts`'s qa-staging build guard now refuses to build qa mode at
# all if this resolves to empty or to the production Railway URL.

# --- Dev-only toggles (不参与生产逻辑或生产 UI) ---
# Local dev: default AI path is client OpenAI unless you set this to opt into backend proxy like prod.
# VITE_USE_AI_BACKEND=true
# Dev: show “Developer: OpenAI API key” panel (set to false to hide). Never shown in import.meta.env.PROD.
# VITE_SHOW_DEV_AI_KEY=false
# Optional: legacy browser key for dev when not using backend (never for production distribution).
# VITE_OPENAI_API_KEY=
# Local A/B only: `true` = in Youmi AI mode, skip live slice MediaRecorder (main recording unchanged).
# VITE_EXPERIMENT_SKIP_YOUMI_LIVE_SLICE=true
# Live captions: **Youmi hosted + production builds** always use PCM → WebSocket → DashScope streaming ASR.
# Dev only: set `VITE_USE_LIVE_ENGINE_V2=false` to exercise legacy MediaRecorder slice + HTTP chunk path (no WS base64 transcribe).
# VITE_USE_LIVE_ENGINE_V2=false
# Verbose client live trace in dev / when true (no tokens in logs).
# VITE_DEBUG_LIVE=true

# --- Tauri desktop auth (magic link / OAuth return path) ---
# In `tauri dev`, magic-link redirect uses: http://localhost:5173/tauri-auth-callback → forwards to lecturecompanion://
# Add BOTH to Supabase → Authentication → URL Configuration → Redirect URLs:
#   http://localhost:5173/tauri-auth-callback
#   lecturecompanion://auth-callback
# Packaged Mac app (production build): default redirect is lecturecompanion://auth-callback unless you set:
# VITE_AUTH_BRIDGE_ORIGIN=https://your-static-host.example.com
# (that host must serve the same SPA so /tauri-auth-callback exists)

# --- Optional product flags ---
# Reserved: login card is email-only; OAuth providers can stay enabled in Supabase for other clients.
# VITE_SHOW_APPLE_SIGNIN=true

# --- Server-side only (npm run dev:server or your hosted API — not bundled into the Vite app) ---
#
# Live realtime ASR (WebSocket /api/live-realtime-ws):
# Product default: always DashScope streaming (requires DASHSCOPE_API_KEY). No auto-switch by Volc env vars.
# Default: JSON `transcribe` + base64 on this socket is **disabled** (PCM streaming only). Internal diagnostics only:
# YOUMI_LIVE_LEGACY_WS_TRANSCRIBE=1
# Internal experiment only — Volc streaming: YOUMI_LIVE_ASR_EXPERIMENT=volcengine (or volc|vol) + Volc keys below.
# DASHSCOPE_API_KEY=sk-...
# Optional: international (Singapore) Model Studio key — server-only. When set, all DashScope calls
# (chat, Paraformer file ASR, realtime WS ASR) use dashscope-intl.aliyuncs.com with this key.
# DASHSCOPE_OVERSEAS_API_KEY=sk-...
# VOLCENGINE_ASR_APP_KEY=...
# VOLCENGINE_ASR_ACCESS_KEY=...
# Optional Volc (experiment): VOLCENGINE_ASR_RESOURCE_ID, VOLCENGINE_ASR_WS_URL (see volcengineStreamingAsr.mjs defaults).
# Per-chunk server logs (default off): YOUMI_LIVE_VERBOSE=1
#
# Real hosted Youmi AI (production-like): set enterprise key and keep stub OFF.
# ENABLE_STUB_AI=false
# Youmi AI (hosted): Alibaba Model Studio — DASHSCOPE_API_KEY (Beijing region API key from Model Studio console).
# Text: OpenAI-compatible chat (Qwen) at dashscope.aliyuncs.com/compatible-mode/v1
# Cloud recording speech: Paraformer async file ASR (HTTPS URL only per official API — server uses Supabase signed URLs).
# Optional text model (default qwen-turbo):
# YUMI_QWEN_CHAT_MODEL=qwen-turbo
# Optional Paraformer model (default paraformer-v2):
# YUMI_PARAFORMER_MODEL=paraformer-v2
# Comma-separated language hints for lecture ASR (default zh,en):
# YUMI_PARAFORMER_LANGUAGE_HINTS=zh,en
# Signed URL lifetime for DashScope to fetch audio from Supabase (seconds, default 7200):
# YUMI_STORAGE_SIGNED_URL_SEC=7200
# Paraformer async task poll interval in ms (default 250; lower = faster completion, more API calls):
# YUMI_PARAFORMER_POLL_INTERVAL_MS=500
# Optional: POST /api/transcribe with raw multipart file — Paraformer cannot accept uploads; set this + OpenAI for Whisper-only buffer path:
# YUMI_HOSTED_TRANSCRIBE_IMPL=openai_fallback
# OPENAI_API_KEY=sk-...
# Local development/demo fallback for hosted Youmi AI when enterprise key is not configured:
# ENABLE_STUB_AI=true
# AI_SERVER_PORT=3847
# Required for POST /api/process-recording (cloud recordings: signed URL → Paraformer → Qwen summaries, write DB):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# Strongly recommended (server only; never VITE_*): service_role key so the AI server can persist ai_status/transcript/summaries reliably after JWT ownership checks. Dashboard → Settings → API.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
#
# App Store Server API / StoreKit 2 verification (server only; never VITE_*).
# Keep the private key and root certificates in deployment secrets or secret files.
# APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_IAP_KEY_ID=your_app_store_connect_iap_key_id
# APPLE_IAP_ISSUER_ID=your_app_store_connect_issuer_id
# APPLE_BUNDLE_ID=com.aydenz.youmilensipad
# APPLE_APP_APPLE_ID=1234567890
# APPLE_IAP_ENVIRONMENT=Sandbox
# APPLE_IAP_ROOT_CERTIFICATE_PATHS=/secure/path/AppleRootCA-G3.cer,/secure/path/AppleRootCA-G4.cer
# APPLE_IAP_ROOT_CERTIFICATES_BASE64=
# APPLE_IAP_ENABLE_ONLINE_CHECKS=true
#
# Quota defaults (server-side only; override without app update).
# BETA_PUBLIC_TRIAL_MAX_RECORDINGS_PER_DAY=2
# BETA_PUBLIC_TRIAL_MAX_PROCESSING_JOBS_PER_DAY=2
# BETA_STUDENT_PASS_MONTHLY_MINUTES=600
# BETA_STUDENT_PASS_DAILY_MINUTES=120
# BETA_STUDENT_PASS_MAX_RECORDING_MINUTES=90
# BETA_STUDENT_PASS_MAX_LIVE_SESSION_MINUTES=90
# BETA_STUDENT_PASS_MAX_RECORDINGS_PER_DAY=6
# BETA_STUDENT_PASS_MAX_PROCESSING_JOBS_PER_DAY=10

# --- Product AI mode (dev) ---
# When true, the web app behaves like production: no local dev API key UI; cloud recordings use POST /api/process-recording only.
# VITE_PRODUCT_AI_MODE=true

# =============================================================================
# Desktop Stripe subscriptions (Commercialization V2 · Phase 1A)
# Website is the billing center; Mac/Windows only read status + redirect here.
# Server-only secrets — never exposed to the desktop app or client.
# =============================================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Server-trusted price ids (the client may only name a plan_code, never a price):
# STRIPE_PRICE_STUDENT_BASIC_MONTHLY=price_...   # US$4.99 / month  -> student_pass
# STRIPE_PRICE_STUDENT_BASIC_ANNUAL=price_...    # US$49.99 / year  -> student_pass
# Past-due grace window before access is withdrawn (days).
# DEFAULT 0 (no grace) — a grace period is NOT an approved product policy yet.
# Access during past_due is not extended beyond the already-paid period unless
# this is explicitly set to a positive number. Leave unset until approved.
# STRIPE_GRACE_PERIOD_DAYS=0
#
# PUBLIC COMMERCIALIZATION RELEASE SWITCH — gates POST /api/billing/checkout.
# FAIL-CLOSED: only the exact value `true` opens paid Checkout. MISSING, EMPTY,
# `false`, or ANY other value keeps Checkout CLOSED (503
# commercialization_not_available). A new environment that forgets this variable
# therefore stays closed rather than accidentally selling.
# Does NOT gate Customer Portal, subscription status/refresh, or the webhook —
# existing subscribers must always be able to manage and cancel.
# Set to `true` only for controlled TEST MODE verification, or when Mac/Windows/
# iPad have caught up and commercialization goes public.
# PUBLIC_COMMERCIALIZATION_ENABLED=true
#
# Website URLs for Checkout success/cancel + Customer Portal return:
# WEBSITE_ORIGIN=https://youmilens.com
# STRIPE_CHECKOUT_SUCCESS_URL=https://youmilens.com/account?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=https://youmilens.com/pricing?checkout=cancelled
# STRIPE_PORTAL_RETURN_URL=https://youmilens.com/account
